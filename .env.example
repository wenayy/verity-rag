# Any OpenAI-compatible provider works. Examples:
#   OpenAI:     (leave BASE_URL empty)                     VERITY_LLM_MODEL=gpt-4.1-mini
#   Groq:       VERITY_LLM_BASE_URL=https://api.groq.com/openai/v1   VERITY_LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: VERITY_LLM_BASE_URL=https://openrouter.ai/api/v1      VERITY_LLM_MODEL=openai/gpt-4.1-mini
#   Ollama:     VERITY_LLM_BASE_URL=http://localhost:11434/v1         VERITY_LLM_MODEL=llama3.1:8b
VERITY_LLM_BASE_URL=
VERITY_LLM_API_KEY=sk-...
VERITY_LLM_MODEL=gpt-4.1-mini

# Embeddings: "lsa" (offline, default) or "openai" (any OpenAI-compatible /embeddings endpoint)
VERITY_EMBED_PROVIDER=lsa
# VERITY_EMBED_MODEL=text-embedding-3-small

# Retrieval / agent knobs
VERITY_RETRIEVAL_MODE=hybrid
VERITY_TOP_K=8
VERITY_USE_QUERY_EXPANSION=true
VERITY_USE_RERANK=true
VERITY_MAX_ITERATIONS=2
VERITY_VERIFY_ANSWERS=true
